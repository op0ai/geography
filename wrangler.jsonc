{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geography-globe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Static assets short-circuit the Worker by default, so `/` was served
    // straight from index.html and the per-view OG rewrite never ran. These
    // routes must reach the Worker first; everything else (hashed JS/CSS,
    // textures, icons) still goes straight to the asset server.
    "run_worker_first": ["/", "/index.html", "/og.png", "/og.svg", "/llms.txt", "/robots.txt", "/.well-known/*"]
  },
  "observability": { "enabled": true }
}
